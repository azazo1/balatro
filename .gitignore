*.exe

# 原始发行包与解包中间产物
.tmp/

# 本地参考仓库, 项目代码不依赖
.references/

# 打包输出
dist/

# agent 录制输出 (just windows run-agent / just macos run-agent)
/recordings/

# 本机私密文件, 如 Android 签名密钥, 绝不应入库
/secrets/

# python 缓存
__pycache__/
*.pyc

# bbnet 原生库的编译目录. 产物在 dist/native/ 下, 打包时才放进 mod 树; mod 目录里旧位置的残留也忽略.
/native/bbnet/target/
/mods/balatrobot/native/

# engine 与它的 Python 绑定的编译目录
target/
node_modules/
/impls/web/client/public/wasm/
/impls/web/wasm/pkg/
# 由 scripts/engine_web_assets.py 从 game/ 生成的原版贴图与字体
/impls/web/client/public/game/
# 由 scripts/web_game.py 生成的浏览器版游戏
/impls/web/client/public/play/

.DS_Store